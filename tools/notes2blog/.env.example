# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: comma-separated fallback list, first one that works is used.
# ANTHROPIC_MODEL=claude-sonnet-4-5,claude-3-7-sonnet-latest

# Optional: always publish onto this branch (empty = whatever branch is checked out)
# PUBLISH_BRANCH=master

# Set to false to commit but NOT push (useful while you're testing)
AUTO_PUSH=true
